  "main": "index.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc && npm run copiar-assets",
    "copiar-assets": "node -e \"require('node:fs').cpSync('src/assets', 'dist/assets', { recursive: true })\"",
    "start": "node dist/server.js",
    "migrate:deploy": "prisma migrate deploy",
    "prisma:generate": "prisma generate",
    "criar-admin": "tsx src/scripts/criarAdmin.ts",
    "criar-admin:prod": "node dist/scripts/criarAdmin.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "lint": "oxlint src",
    "typecheck": "tsc -p tsconfig.test.json"
  },
