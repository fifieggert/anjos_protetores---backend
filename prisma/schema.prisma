generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

enum PerfilUsuario {
  ADMIN
  FUNCIONARIO
  VOLUNTARIO
}

enum Especie {
  CACHORRO
  GATO
  OUTRO
}

enum Porte {
  PEQUENO
  MEDIO
  GRANDE
}

enum StatusAnimal {
  DISPONIVEL
  EM_TRATAMENTO
  // reservado por um interesse de adoção em andamento (só muda pelo fluxo de adoção)
  EM_ESPERA
  ADOTADO
}

enum Sexo {
  MACHO
  FEMEA
}

enum CategoriaItem {
  RACAO
  MEDICAMENTO
  HIGIENE
  LIMPEZA
  ACESSORIO
}

enum StatusSolicitacao {
  PENDENTE
  EM_CONTATO
  APROVADA
  RECUSADA
}

model Usuario {
  id         String   @id @default(uuid())
  nome       String
  cpf        String   @unique
  email      String   @unique
  senhaHash  String
  perfil     PerfilUsuario
  ativo      Boolean  @default(true)
  criadoEm   DateTime @default(now())

  animais       Animal[]
  doacoes       Doacao[]
  saidasEstoque SaidaEstoque[]
  termosGerados TermoAdocao[]
}

model Animal {
  id                String @id @default(uuid())

  usuarioCadastroId String
  usuarioCadastro   Usuario @relation(fields: [usuarioCadastroId], references: [id])

  nome        String
  especie     Especie
  raca        String?
  idade       Int?
  porte       Porte
  status      StatusAnimal @default(DISPONIVEL)
  fotoUrl     String?
  // também é a observação impressa no termo de adoção
  descricao   String?

  // opcional: os animais já cadastrados não têm essa informação e não há valor padrão seguro
  sexo            Sexo?
  castrado        Boolean   @default(false)
  dataCastracao   DateTime?
  vacinado        Boolean   @default(false)
  dosesVacina     Int?
  dataRevacinacao DateTime?

  criadoEm DateTime @default(now())

  solicitacoes SolicitacaoAdocao[]
  termos       TermoAdocao[]
}

model ItemEstoque {
  id                String @id @default(uuid())

  nomeItem          String
  categoria         CategoriaItem

  quantidadeAtual   Int
  quantidadeMinima  Int

  criadoEm DateTime @default(now())

  doacoes Doacao[]
  saidas  SaidaEstoque[]
}

model Doacao {
  id          String @id @default(uuid())

  itemId      String
  item        ItemEstoque @relation(fields: [itemId], references: [id])

  usuarioId   String
  usuario     Usuario @relation(fields: [usuarioId], references: [id])

  quantidade  Int
  doador      String

  dataEntrada DateTime @default(now())
}

model SaidaEstoque {
  id          String @id @default(uuid())

  itemId      String
  item        ItemEstoque @relation(fields: [itemId], references: [id])

  usuarioId   String
  usuario     Usuario @relation(fields: [usuarioId], references: [id])

  quantidade  Int
  finalidade  String

  dataSaida   DateTime @default(now())
}

// Interesse de adoção registrado no site público. Só guardamos nome e telefone
// do interessado: o restante do contato é feito por fora do sistema.
model SolicitacaoAdocao {
  id           String @id @default(uuid())

  animalId     String
  animal       Animal @relation(fields: [animalId], references: [id])

  nome         String @db.VarChar(100)
  // somente dígitos, com DDD (10 ou 11 dígitos)
  telefone     String @db.VarChar(11)

  status       StatusSolicitacao @default(PENDENTE)

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  termos       TermoAdocao[]

  @@index([telefone, status])
  @@index([animalId, status])
}

// Registro de cada geração do termo de adoção (o PDF não fica guardado).
model TermoAdocao {
  id            String @id @default(uuid())

  animalId      String
  animal        Animal @relation(fields: [animalId], references: [id])

  // excluir a solicitação (direito de exclusão) mantém o registro do termo, sem o vínculo
  solicitacaoId String?
  solicitacao   SolicitacaoAdocao? @relation(fields: [solicitacaoId], references: [id], onDelete: SetNull)

  geradoPorId   String
  geradoPor     Usuario @relation(fields: [geradoPorId], references: [id])

  geradoEm      DateTime @default(now())

  assinado      Boolean   @default(false)
  assinadoEm    DateTime?
}