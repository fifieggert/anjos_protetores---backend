# Variáveis da API no docker-compose.yml (SOMENTE desenvolvimento local).
# Todos os valores são FALSOS. Para mudar algo, copie para .env.docker (fora do git):
# o compose lê este arquivo e, depois, o .env.docker, que tem prioridade.
# O DATABASE_URL é montado no docker-compose.yml a partir da senha do MySQL local.

# Segredo dos tokens JWT. Valor de exemplo: NÃO use em produção.
JWT_SECRET=troque-este-segredo-local-de-desenvolvimento

PORT=4000
CORS_ORIGIN=http://localhost:5173

# Sem proxy na frente no ambiente local
TRUST_PROXY=

# Opcionais do termo de adoção em PDF
ABRIGO_CIDADE=
ABRIGO_TELEFONE=

# Upload de imagens: a imagem roda com NODE_ENV=production, então a pasta local é recusada.
# Sem S3_BUCKET o upload responde 503 (o resto funciona). Para testar o upload, use o
# "npm run dev" (pasta ./uploads) ou um bucket de teste com credenciais da AWS no ambiente.
STORAGE_DRIVER=s3
S3_BUCKET=
AWS_REGION=sa-east-1
