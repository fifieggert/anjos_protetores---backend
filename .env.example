# Copie este arquivo para .env e preencha os valores.

# Conexão com o MySQL, ex.: mysql://usuario:senha@localhost:3306/anjos_protetores
DATABASE_URL=

# Segredo usado para assinar os tokens JWT (obrigatório).
# Gere um valor aleatório, ex.: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Porta do servidor (padrão: 4000)
PORT=4000

# Origens que podem chamar a API pelo navegador (CORS), separadas por vírgula.
# Sem barra no final. Padrão: http://localhost:5173
# Produção, ex.: https://anjos.exemplo.org,https://www.anjos.exemplo.org
CORS_ORIGIN=http://localhost:5173

# Número de proxies reversos (Nginx, load balancer) à frente da API. Com 1 ou mais, o IP
# real do visitante vem do X-Forwarded-For (usado pelo limitador de requisições).
# Vazio ou 0 = desligado (padrão; use assim em desenvolvimento, sem proxy).
# Produção atrás de um Nginx: TRUST_PROXY=1
TRUST_PROXY=

# Opcionais: aparecem no termo de adoção em PDF (sem elas, a linha sai em branco).
# Cidade do fecho do termo, ex.: Blumenau/SC
ABRIGO_CIDADE=
# Telefone do abrigo abaixo da assinatura do responsável, ex.: (47) 99999-9999
ABRIGO_TELEFONE=

# Upload de imagens (POST /api/imagens). Onde os arquivos ficam:
#   local = pasta ./uploads (SOMENTE desenvolvimento; está no .gitignore)
#   s3    = bucket S3 (produção). Credenciais pela cadeia padrão da AWS (na EC2, a role da
#           instância): NUNCA coloque chaves de acesso aqui.
# Padrão: local fora de produção e s3 em produção. Em produção, local é recusado e, sem
# S3_BUCKET, a API sobe normalmente mas o upload responde 503.
STORAGE_DRIVER=local
# Nome do bucket (só com STORAGE_DRIVER=s3), ex.: anjos-uploads-123456789012
S3_BUCKET=
# Região do bucket (padrão: sa-east-1)
AWS_REGION=sa-east-1
